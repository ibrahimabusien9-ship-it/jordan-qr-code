<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Join Our Club</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
  :root{
    --jo-red:#CE1126;
    --jo-black:#000000;
    --jo-green:#007A3D;
    --jo-white:#FFFFFF;
    --jo-sand:#F4E9D8;
    --card-bg: rgba(255,255,255,0.96);
    --text-main:#1a1a1a;
    box-sizing:border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --card-bg: rgba(30,26,20,0.96);
      --text-main:#F4E9D8;
    }
  }
  :root[data-theme="dark"]{
    --card-bg: rgba(30,26,20,0.96);
    --text-main:#F4E9D8;
  }
  html{scroll-padding-top: env(safe-area-inset-top, 0px);}
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    margin:0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background:
      linear-gradient(135deg, var(--jo-black) 0%, var(--jo-black) 34%, var(--jo-white) 34%, var(--jo-white) 40%, var(--jo-green) 40%, var(--jo-green) 74%, var(--jo-red) 74%);
    background-attachment: fixed;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:24px;
    position:relative;
    overflow-x:hidden;
  }
  /* subtle geometric star pattern overlay, nod to Jordanian mosaic art */
  body::before{
    content:"";
    position:fixed;
    inset:0;
    background-image:
      repeating-linear-gradient(45deg, rgba(255,255,255,0.04) 0 2px, transparent 2px 22px),
      repeating-linear-gradient(-45deg, rgba(255,255,255,0.04) 0 2px, transparent 2px 22px);
    pointer-events:none;
  }
  .card{
    position:relative;
    background: var(--card-bg);
    border-radius:20px;
    padding:36px 30px 30px;
    max-width:420px;
    width:100%;
    text-align:center;
    box-shadow: 0 20px 50px rgba(0,0,0,0.35);
    border: 3px solid var(--jo-black);
  }
  .flag-strip{
    position:absolute;
    top:0; left:0; right:0;
    height:8px;
    border-radius:20px 20px 0 0;
    background: linear-gradient(90deg, var(--jo-black) 33%, var(--jo-white) 33%, var(--jo-white) 66%, var(--jo-green) 66%);
    overflow:hidden;
  }
  .triangle{
    position:absolute;
    top:0; left:0;
    width:0; height:0;
    border-top: 60px solid var(--jo-red);
    border-right: 60px solid transparent;
  }
  .star{
    position:absolute;
    top:12px; left:10px;
    color:var(--jo-white);
    font-size:20px;
    line-height:1;
  }
  h1{
    color:var(--text-main);
    font-size:1.5rem;
    margin:28px 0 6px;
    letter-spacing:0.5px;
  }
  p.subtitle{
    color:var(--text-main);
    opacity:0.75;
    margin:0 0 22px;
    font-size:0.95rem;
  }
  #qrcode{
    display:flex;
    justify-content:center;
    margin:0 auto 22px;
    padding:14px;
    background:var(--jo-white);
    border-radius:14px;
    border:3px solid var(--jo-green);
    width:fit-content;
  }
  #qrcode img, #qrcode canvas{
    border-radius:6px;
  }
  .btn{
    display:inline-block;
    width:100%;
    padding:15px 20px;
    font-size:1.05rem;
    font-weight:700;
    color:var(--jo-white);
    background: linear-gradient(90deg, var(--jo-red), var(--jo-green));
    border:none;
    border-radius:12px;
    cursor:pointer;
    letter-spacing:0.3px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    box-shadow: 0 8px 20px rgba(0,0,0,0.25);
  }
  .btn:hover{
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(0,0,0,0.32);
  }
  .btn:active{
    transform: translateY(0);
  }
  .hint{
    margin-top:14px;
    font-size:0.8rem;
    color:var(--text-main);
    opacity:0.6;
  }
  .footer-note{
    margin-top:18px;
    font-size:0.75rem;
    color:var(--text-main);
    opacity:0.5;
  }
</style>
</head>
<body>
  <div class="card">
    <div class="flag-strip"></div>
    <div class="triangle"></div>
    <div class="star">★</div>

    <h1>Join Our Club</h1>
    <p class="subtitle">Scan the QR code or tap the button below to join</p>

    <div id="qrcode"></div>

    <button class="btn" id="redirectBtn">Take Me There →</button>
    <p class="hint">Having trouble scanning? Just tap the button above.</p>
  </div>

<script>
  var destinationUrl = "https://connect.adu.ac.ae/club/1778220083490x308512664100012000";

  new QRCode(document.getElementById("qrcode"), {
    text: destinationUrl,
    width: 220,
    height: 220,
    colorDark: "#000000",
    colorLight: "#ffffff",
    correctLevel: QRCode.CorrectLevel.H
  });

  document.getElementById("redirectBtn").addEventListener("click", function(){
    window.location.href = destinationUrl;
  });
</script>
</body>
</html>
